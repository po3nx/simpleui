{
  "name": "@simpleui/angular",
  "version": "0.0.0",
  "description": "Angular adapter for SimpleUI",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=24.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty false",
    "clean": "node ../../tools/clean.mjs ."
  },
  "dependencies": {
    "@simpleui/core": "workspace:*",
    "@simpleui/datagrid": "workspace:*"
  },
  "peerDependencies": {
    "@angular/common": ">=17 <23",
    "@angular/core": "^22.0.0",
    "@angular/platform-browser": "^22.0.0"
  },
  "devDependencies": {
    "@simpleui/testing": "workspace:*",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "@angular/platform-browser": "22.3.0",
    "@angular/compiler": "22.3.0",
    "rxjs": "^7.8.2",
    "tslib": "^2.9.1"
  }
}
