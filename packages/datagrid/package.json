{
  "name": "@simpleui/datagrid",
  "version": "0.0.0",
  "description": "High-performance data grid for SimpleUI",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=24.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./styles.css": "./dist/styles.css"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc -b && node ../../tools/build-css.mjs --in src/styles/grid.css --out dist/styles.css",
    "typecheck": "tsc -b --pretty false",
    "clean": "node ../../tools/clean.mjs .",
    "test": "vitest run"
  },
  "dependencies": {
    "@simpleui/core": "workspace:*"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
