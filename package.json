{
  "name": "simpleui",
  "version": "0.0.0",
  "private": true,
  "description": "Framework-agnostic enterprise UI components",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=12.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "typecheck": "turbo run typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "turbo run test",
    "test:unit": "turbo run test:unit",
    "clean": "node tools/clean.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "audit": "pnpm audit --audit-level high",
    "audit:all": "pnpm audit",
    "audit:prod": "pnpm audit --prod --audit-level high",
    "outdated": "pnpm outdated",
    "changeset": "changeset"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.9",
    "@eslint/js": "10.0.1",
    "@types/node": "^24.0.0",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript-eslint": "8.73.0"
  }
}
