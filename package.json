{
  "name": "simpleui",
  "version": "0.0.0",
  "private": true,
  "description": "Framework-agnostic enterprise UI components",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=12.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "check:package": "node tools/check-packaging.mjs",
    "dev": "turbo run dev --parallel",
    "typecheck": "turbo run typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "turbo run test",
    "test:unit": "turbo run test:unit",
    "test:coverage": "vitest run --coverage",
    "test:browser": "vitest run --project browser",
    "test:e2e": "playwright test --project=chromium",
    "test:e2e:all": "playwright test",
    "clean": "node tools/clean.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "audit": "pnpm audit --audit-level high",
    "audit:all": "pnpm audit",
    "audit:prod": "pnpm audit --prod --audit-level high",
    "outdated": "pnpm outdated",
    "changeset": "changeset",
    "changeset:status": "changeset status",
    "changeset:version": "changeset version"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@types/node": "^24.0.0",
    "@vitest/browser": "5.1.1",
    "@vitest/browser-playwright": "5.1.1",
    "@vitest/coverage-v8": "5.1.1",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "playwright": "1.65.1",
    "prettier": "^3.4.2",
    "publint": "0.3.25",
    "turbo": "^2.3.3",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.1"
  }
}
